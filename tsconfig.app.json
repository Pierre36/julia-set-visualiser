{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*"],
  "exclude": ["src/test/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ESNext", "dom"],
    "types": ["@webgpu/types"],
    "paths": {
      "@/*": ["./src/main/*"]
    }
  }
}
